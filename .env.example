# Server Port
PORT=5000

# PostgreSQL Database Configuration
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=admin
PGDATABASE=akademiya

# JWT Secret Key
JWT_SECRET=your_jwt_secret

# Ollama Local AI Configuration (legacy, no longer used by modelAdapter.js)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_GEN_MODEL=gemma4:e4b
OLLAMA_EMBED_MODEL=nomic-embed-text:latest

# LM Studio Local AI Configuration (primary provider — OpenAI-compatible local server)
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=gemma-3n-e4b
LMSTUDIO_EMBED_MODEL=text-embedding-nomic-embed-text-v1.5
LMSTUDIO_TIMEOUT_MS=4000

# Gemini API Configuration (fallback provider when LM Studio is unreachable)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_TIMEOUT_MS=9000
